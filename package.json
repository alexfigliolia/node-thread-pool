{
  "name": "@figliolia/thread-pool",
  "version": "2.0.0",
  "description": "A type-safe work stealing thread pool for the web and node.js",
  "keywords": [
    "concurrency",
    "multi-threading",
    "node.js",
    "parallelism",
    "thread pool",
    "web workers",
    "workers"
  ],
  "homepage": "https://github.com/alexfigliolia/thread-pool#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/thread-pool.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.mts",
  "exports": {
    "./node": {
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./web": {
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware --report-unused-disable-directives --fix && oxfmt",
    "test": "vitest"
  },
  "devDependencies": {
    "@figliolia/event-emitter": "^2.0.0",
    "@types/node": "^22.20.2",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@figliolia/event-emitter": ">=2.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
